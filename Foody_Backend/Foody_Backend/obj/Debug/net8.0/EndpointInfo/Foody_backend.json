            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "cuisineTags": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "priceLevel": {
            "type": "integer",
            "format": "int32"
          },
          "thumbnailImageUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
